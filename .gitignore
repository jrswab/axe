# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib
axe*

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# env file
.env

# Release artifacts (generated by CI workflow)
release-notes.md

# Editor/IDE
.idea/
.vscode/
.opencode/
.entire/
.kiro/
.agents/*
!.agents/factory-gates.json
!.agents/scripts/
.agents/scripts/*
!.agents/scripts/ci-check
!.agents/scripts/check-dry-skill
!.agents/scripts/release-check
!.agents/scripts/tests/
.agents/scripts/tests/*
!.agents/scripts/tests/test_dry_skill.py
!.agents/scripts/tests/test_check_dry_skill.py
!.agents/scripts/tests/test_ci_check.py
!.agents/scripts/tests/test_release_check.py
!.agents/scripts/tests/test_release_tag_binding.py

# Documentation Tools
docs/book/
